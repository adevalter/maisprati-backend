# Variáveis para Portainer stack petshop-api (develop)
# Copie para .env e preencha as senhas / JWT.

IMAGE_TAG=latest
SERVER_PORT=8080

TRAEFIK_API_HOST=petshop-api.aw.api.br

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/petshop
SPRING_DATASOURCE_USERNAME=petshop
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

# Valores com espaço precisam de aspas (senão o bash quebra no source .env)
APP_SHOP_NAME="Pet Shop"
APP_JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
APP_JWT_EXPIRATION_MS=86400000

APP_OWNER_EMAIL=dono@petshop.local
APP_OWNER_PASSWORD=dono123
APP_OWNER_NAME=Dono

APP_ATTENDANT_EMAIL=atendente@petshop.local
APP_ATTENDANT_PASSWORD=atendente123
APP_ATTENDANT_NAME=Atendente

# Origens do front (separadas por vírgula) — deve incluir a URL HTTPS do Traefik
APP_CORS_ALLOWED_ORIGINS="https://petshop-front.aw.api.br,http://localhost:3000"
